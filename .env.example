# Copy to .env and fill in. .env is gitignored; never commit real values.
#
#     cp .env.example .env
#
# Note there are TWO env files in this repo and they are not the same thing:
#   .env       (here, repo root)  the app and the Docker stack
#   ml/.env                       the ML scripts, Spotify credentials for scraping
# The Spotify values are the same in both. The duplication is deliberate: the
# ML tooling runs standalone, outside the container, against the same app.

# ── required ────────────────────────────────────────────────────────────────

# Flask signs session cookies with this. Any long random string.
#     python -c "import secrets; print(secrets.token_hex(32))"
# Treat it like a password: anyone who has it can forge a logged-in session.
# A previous value of this was committed to the public repo, which is why the
# app will soon refuse to start rather than fall back to a default.
SECRET_KEY=

# ── Spotify ─────────────────────────────────────────────────────────────────
# https://developer.spotify.com/dashboard → your app → Settings
# Leave blank to run the app without the login flow (most pages still render).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Permissions requested at login. user-top-read is what the match flow needs.
SCOPE=user-top-read user-read-recently-played

# Must exactly match a Redirect URI registered in the Spotify dashboard,
# including the port. For local Docker that is the line below.
BASE_URL=http://127.0.0.1:8080

# ── database ────────────────────────────────────────────────────────────────
# Compose supplies this automatically; it is here so you can point at something
# else. Railway injects its own DATABASE_URL and that value wins.
# DATABASE_URL=postgresql+psycopg://lovify:lovify@db:5432/lovify

POSTGRES_USER=lovify
POSTGRES_PASSWORD=lovify
POSTGRES_DB=lovify

# ── ports, if the defaults clash with something already running ─────────────
# 5433 rather than 5432 on purpose: a lot of machines already have Postgres.
WEB_HOST_PORT=8080
DB_HOST_PORT=5433

# ── dev ─────────────────────────────────────────────────────────────────────
# 1 = auto-reload on edit and tracebacks in the browser. Never 1 in deployment.
FLASK_DEBUG=1
